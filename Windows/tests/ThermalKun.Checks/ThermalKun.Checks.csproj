<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ThermalKun.Core/ThermalKun.Core.csproj" />
    <Compile Include="../../src/ThermalKun.App/NativeSensors.cs" Link="NativeSensors.cs" />
    <Compile Include="../../src/ThermalKun.App/TemperatureSelection.cs" Link="TemperatureSelection.cs" />
    <Compile Include="TemperatureChecks.cs" />
    <Compile Include="../../src/ThermalKun.App/SensorPipeWriter.cs" Link="SensorPipeWriter.cs" />
    <Compile Include="SensorPipeChecks.cs" />
  </ItemGroup>
  <PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup><Compile Include="Program.cs" /></ItemGroup>
</Project>
